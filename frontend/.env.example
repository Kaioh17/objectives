# Documents every variable. Copy to .env.local for secrets and personal overrides.
# Load order (first match wins): process env > .env.$NODE_ENV.local > .env.local > .env.$NODE_ENV
# .env.development / .env.production are committed and hold NON-SECRET defaults only.

# --- Public (NEXT_PUBLIC_*) -------------------------------------------------
# Inlined into the browser bundle at BUILD time. Visible to everyone; never put secrets here.
# Changing one requires a rebuild.

# development | staging | production. Separate from NODE_ENV: staging is still a production build.
# Staging build: NEXT_PUBLIC_APP_ENV=staging npm run build
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Next Boilerplate
# API base URL as the browser sees it, no trailing slash. The browser calls the API directly, so the
# API must be same-site with the app (localhost:3000 and localhost:8000, or app.example.com and
# api.example.com), or the SameSite=Lax refresh cookie is not sent. The backend CORS must list the app.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Landing page origin and app origin (login, signup, objectives), no trailing slash.
# Dev: both http://localhost:3000, which turns the host split in src/proxy.ts off. Production
# values go in .env.production.local or the platform env, never in committed files.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated feature flags, e.g. beta-ui,new-nav
NEXT_PUBLIC_FEATURES=

# --- Server only (no prefix) ------------------------------------------------
# Read at RUNTIME, only on the server (src/config/env.server.ts). Set via your platform's
# secret store in staging/production; put real values in .env.local for development.

# Min 32 chars. Required outside development.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
