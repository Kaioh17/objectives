# Committed. Non-secret defaults for `npm run build` (NODE_ENV=production).
# Production domains are deliberately NOT here. Put NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SITE_URL and
# NEXT_PUBLIC_APP_URL in .env.production.local (git-ignored) or the platform's env / Docker build args.
# The build fails if they are missing.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=Objectives
