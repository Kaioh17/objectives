# Committed. Non-secret defaults for `npm run dev`. Secrets go in .env.local.
# App and API both sit on localhost (ports do not matter for "same site"), so the SameSite=Lax
# refresh cookie reaches the API on direct calls.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Objectives
