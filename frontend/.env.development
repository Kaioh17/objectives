# Committed. Non-secret defaults for `npm run dev`. Secrets go in .env.local.
# *.localhost resolves to loopback in browsers, so no /etc/hosts entry is needed.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_PUBLIC_APP_NAME=Objectives
