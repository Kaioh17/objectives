APP_NAME=FastAPI Boilerplate
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Comma-separated list of allowed origins
# Include the frontend app origin (NEXT_PUBLIC_APP_URL). Real production origins go in the deployed env only.
CORS=http://localhost:3000,http://app.localhost:3000,http://localhost:5173

# Pick ONE database (see README "Choosing a database").
#
# SQLite: local dev, tests, prototypes. Zero setup, single file, one writer at a time.
#   Not for multiple app instances or heavy concurrent writes.
#DATABASE_URL=sqlite:///./app.db
#
# PostgreSQL: production, concurrent users, multiple app instances, real migrations.
#   Local via `docker compose up -d db`, or any managed Postgres (RDS, Cloud SQL, ...).
# DATABASE_URL=postgresql://app:app@localhost:5432/app
#
# Supabase: hosted PostgreSQL, no DB to run yourself (MVPs, small teams, managed backups).
#   Paste the Session pooler string from Dashboard > Connect; keep ?sslmode=require.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Signs the Google OAuth state and derives the key that encrypts stored Google tokens.
# Changing it makes every user reconnect Google.
SECRET_KEY=change-me

# Login lasts this many days and slides forward every day the user comes back
SESSION_DAYS=90

# Neon (filled by `neon deploy`; names follow Neon's convention)
# DATABASE_URL            pooled connection, used by the running app
# DATABASE_URL_UNPOOLED   direct connection, used by `alembic upgrade head`
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Next.js app origin, where Google sign-in sends the browser back to (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Google Cloud OAuth client, see GOOGLE_SETUP.md. Leave blank to disable Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
